NODE_ENV=development

# ── Modo de depuración de logs del framework NestJS ──
# false (por defecto): Oculta los más de 40 logs repetitivos de carga interna ([InstanceLoader], [RouterExplorer])
# true: Muestra toda la traza interna de mapeo de rutas y módulos de NestJS al arrancar
NEST_DEBUG=false

# ═══════════════════════════════════════════════════════════
# 💡 TOGGLE THIS SINGLE LINE to switch between local-only & LAN demo
# Use 'localhost' when working alone.
# Use your LAN IP (e.g. 192.168.100.13) when demoing from phone.
# ═══════════════════════════════════════════════════════════
DEV_HOST=localhost
# DEV_HOST=192.168.100.13

FRONTEND_PORT=5173
BACKEND_PORT=3000

# ── Chained variables (expandVariables: true in ConfigModule) ──
FRONTEND_ORIGIN=http://$DEV_HOST:$FRONTEND_PORT
HOST_API=http://$DEV_HOST:$BACKEND_PORT/api

# ── Database ──
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres

# ── JWT ──
JWT_SECRET=
JWT_EXPIRES_IN=

# ── Seed defaults (SOLO permitidos en desarrollo cuando NODE_ENV=development) ──
# ⚠️ SEGURIDAD: En producción, el endpoint y script de seed están estrictamente desactivados.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ELENA_PASSWORD=
SEED_CARLOS_PASSWORD=
SEED_ANA_PASSWORD=
SEED_INACTIVE_PASSWORD=
SEED_BULK_PASSWORD=
# URL opcional de imagen de Cloudinary para el docente Carlos (vacio para omitir o usar canonical por defecto)
SEED_CARLOS_IMAGEN=

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cryptography & Document QR Verification ──
# Dynamic institution prefix (e.g., SS for SS-DOC:v1:..., UESS for UESS-DOC:v1:...)
QR_PREFIX=
# Version of the digital seal scheme (e.g., v1, v2)
QR_VERSION=v1
# 32+ character secure key used to sign and AES-256-GCM encrypt QR seals
QR_SECRET_KEY=

# ── Cloudflare Turnstile Bot Protection ──
# BACKEND ONLY: Secret key used on the server to verify tokens via Cloudflare API.
# Clave de prueba oficial de Cloudflare para desarrollo (Always-Pass): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# In production, replace with your real SECRET Key from Cloudflare dashboard.
# NOTA: En entorno de desarrollo (NODE_ENV=development), puedes enviar tokens de prueba como
# "XXXX.DUMMY.TOKEN.XXXX", "1x00000000000000000000AA" o "bypass-dev-token" para probar endpoints en Swagger (/docs).
