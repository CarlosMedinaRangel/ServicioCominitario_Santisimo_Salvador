NODE_ENV=development

# ── Modo de depuración de logs del framework NestJS ──
# false (por defecto): Oculta los más de 40 logs repetitivos de carga interna ([InstanceLoader], [RouterExplorer])
# true: Muestra toda la traza interna de mapeo de rutas y módulos de NestJS al arrancar
NEST_DEBUG=false

# ═══════════════════════════════════════════════════════════
# 💡 TOGGLE THIS SINGLE LINE to switch between local-only & LAN demo
# Use 'localhost' when working alone.
# Use your LAN IP (e.g. 192.168.100.13) when demoing from phone.
# ═══════════════════════════════════════════════════════════
DEV_HOST=localhost
# DEV_HOST=192.168.100.13

FRONTEND_PORT=5173
BACKEND_PORT=3000

# ── Chained variables (expandVariables: true in ConfigModule) ──
FRONTEND_ORIGIN=http://$DEV_HOST:$FRONTEND_PORT
HOST_API=http://$DEV_HOST:$BACKEND_PORT/api

# ── Database ──
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres

# ── JWT ──
JWT_SECRET=
JWT_EXPIRES_IN=

# ── Seed defaults ──
SEED_ADMIN_EMAIL=admin@santisimo.edu
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrador del Sistema
SEED_EMPLOYEE_NAME=Dr. Elena Rodríguez
SEED_EMPLOYEE_CEDULA=V882924

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cryptography & Document QR Verification ──
# Dynamic institution prefix (e.g., SS for SS-DOC:v1:..., UESS for UESS-DOC:v1:...)
QR_PREFIX=
# Version of the digital seal scheme (e.g., v1, v2)
QR_VERSION=v1
# 32+ character secure key used to sign and AES-256-GCM encrypt QR seals
QR_SECRET_KEY=

# ── Cloudflare Turnstile Bot Protection ──
# BACKEND ONLY: Secret key used on the server to verify tokens via Cloudflare API.
# Development test key (official Cloudflare Always-Pass secret key, no account needed for dev):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# In production, replace with your SECRET Key from Cloudflare dashboard.
# NOTE: The public Site Key (e.g. VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA) 
# is ONLY used in the Frontend (.env of the frontend repository) to render the widget.
